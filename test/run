#!/usr/bin/env bash
#
# test/run: tests of memex-jenkins, offline.
#
# curl is test/bin/curl, a fake that answers from fixtures in
# test/fixtures and logs what the adapter asked. Each test gets its own
# routes, log and HOME under a temporary directory; JENKINS_USER and
# JENKINS_TOKEN are unset unless the test sets them.
#

set -e

CURDIR=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
ADAPTER=$(dirname "$CURDIR")/memex-jenkins
ADDR=https://ci.example.org/job/project-reviews
# A token curl's config must quote
SECRET='pa"ss\word'
DIR=$(mktemp -d)
FAILED=0

die() {
  echo "$*" >&2
  exit 1
}

usage() {
  cat << EOF
Usage: $0 [TEST...]

Runs the given tests, or all of them:
$(declare -F | cut -d' ' -f3 | grep '^test_' | sed 's/^/  /')
EOF
}

cleanup() {
  rm -rf "$DIR"
}

# Answer METHOD URL with test/fixtures/FIXTURE, or nothing for -, and
# HTTP status CODE, 200 by default
route() {
  echo "$1 $2 $3 ${4:-200}" >> "$FAKE/routes"
}

# Run the adapter's ci role: ARGS, stdin from IN; sets OUT, ERR and
# STATUS
call() {
  STATUS=0
  "$ADAPTER" "$ADDR" ci "$@" < "$IN" > "$TEST_DIR/out" \
    2> "$TEST_DIR/err" || STATUS=$?
  OUT=$(< "$TEST_DIR/out")
  ERR=$(< "$TEST_DIR/err")
}

# jq FILTER on the records printed, as one array
records() {
  jq -scr "$1" <<< "$OUT"
}

# jq FILTER on the requests curl got, as one array
requests() {
  touch "$FAKE/log"
  jq -scr "$1" "$FAKE/log"
}

login() {
  export JENKINS_USER='CORP\jdoe' JENKINS_TOKEN=$SECRET
}

check() {
  [ "$2" == "$3" ] && return
  echo "# $1: expected '$3', got '$2'"
  FAILED=$((FAILED + 1))
}

check_has() {
  [[ $2 == *"$3"* ]] && return
  echo "# $1: '$2' lacks '$3'"
  FAILED=$((FAILED + 1))
}

# Compare jq FILTER on the records with the JSON on stdin
check_json() {
  check "$1" "$(jq -sc "$2" <<< "$OUT" | jq -cS .)" "$(jq -cS .)"
}

# Fails a test that asked for something without a route or put the
# token on curl's command line
audit() {
  local bad
  [ -f "$FAKE/log" ] || return 0
  bad=$(jq -r --arg secret "$SECRET" '
      if .unexpected then "unexpected request: \(.method) \(.url)"
      elif (.args + [.url] | any(contains($secret)))
      then "token on the command line: \(.url)"
      else empty end' "$FAKE/log")
  [ -n "$bad" ] || return 0
  sed 's/^/# /' <<< "$bad"
  FAILED=$((FAILED + 1))
}

test_capabilities() {
  call capabilities
  check status "$STATUS" 0
  check_json capabilities '.[0]' << 'EOF'
{"tests": true, "logs": true, "retest": true, "bugs": false}
EOF
  check requests "$(requests length)" 0
}

test_other_role() {
  STATUS=0
  "$ADAPTER" "$ADDR" tracker capabilities < "$IN" 2> /dev/null || STATUS=$?
  check status "$STATUS" 2
}

test_unknown_command() {
  call locate cdc3609
  check status "$STATUS" 2
}

test_usage() {
  call run
  check "no run" "$STATUS" 1
  STATUS=0
  "$ADAPTER" ci.example.org ci run 1 < "$IN" 2> /dev/null || STATUS=$?
  check "not a URL" "$STATUS" 1
  check requests "$(requests length)" 0
}

REVISION='actions[parameters[name,value],lastBuiltRevision[SHA1]]'
BUILD="url,_class,result,building,timestamp,duration,$REVISION"
RUNS="$BUILD,number,runs[number,url,result,building,timestamp,duration]"
SHA=cdc360986f2590957d6fb1296b7bccfa5fdafa34
EL9=$ADDR/arch=x86_64,build_type=server,distro=el9.7,ib_stack=inkernel/134377/

# The builds of the job or folder at URL: FIXTURE [CODE]
route_builds() {
  route GET "$1/api/json?tree=jobs[url],builds[url,$REVISION]" \
    "$2" "${3:-200}"
}

# Two matrix builds of SHA: 134377 for change 69978, and 134371 without
# Gerrit
route_matrix() {
  route_builds "$ADDR" job.json
  route GET "$ADDR/134377/api/json?tree=$RUNS" build-134377.json
  route GET "$ADDR/134371/api/json?tree=$RUNS" build-134371.json
}

# Each configuration of this round of a matrix build is a run
test_runs_matrix() {
  route_matrix
  call runs cdc3609
  check status "$STATUS" 0
  check runs "$(records '[.[].id | sub(".*/project-reviews/"; "")] | .[]')" \
    "arch=aarch64,build_type=client,distro=rocky9.5,ib_stack=inkernel/134377/
arch=x86_64,build_type=server,distro=el9.7,ib_stack=inkernel/134377/
arch=x86_64,build_type=client,distro=el10.0,ib_stack=inkernel/134371/"
  check_json run '.[1]' << EOF
{"id": "$EL9", "source": "$ADDR", "role": "ci", "kind": "run",
 "basis": "FAILURE",
 "links": [["commit", "$SHA"], ["change", "69978"], ["revision", "2"]],
 "data": {"commit": "$SHA", "status": "done", "result": "fail",
          "started": "2026-10-23T13:17:06Z",
          "finished": "2026-10-23T14:08:46Z", "url": "$EL9",
          "config": {"arch": "x86_64", "build_type": "server",
                     "distro": "el9.7", "ib_stack": "inkernel"}},
 "notes": {}}
EOF
  check_json running '.[2] | [.basis, .links, .data.status,
      .data.result, .data.finished]' << EOF
["running", [["commit", "$SHA"]], "running", null, null]
EOF
  check anonymous "$(requests '[.[].auth] | unique | .[]')" netrc-optional
}

test_runs_full_commit() {
  route_builds "$ADDR" job.json
  route GET "$ADDR/134380/api/json?tree=$RUNS" build-134377.json
  call runs f6b4b8962ee992b3865774309071125ce05db09d
  check status "$STATUS" 0
  check count "$(records length)" 2
}

test_runs_none() {
  route_builds "$ADDR" job.json
  call runs 0123456789ab
  check status "$STATUS" 0
  check output "$OUT" ''
  check requests "$(requests length)" 1
}

test_runs_not_a_commit() {
  call runs CDC3609
  check uppercase "$STATUS" 1
  call runs cdc360
  check short "$STATUS" 1
  check requests "$(requests length)" 0
}

# A server or folder stands for every job under it
test_runs_folder() {
  local tools=https://ci.example.org/job/tools
  route_matrix
  route_builds "$tools" folder.json
  route_builds "$tools/job/lint" lint.json
  route GET "$tools/job/lint/88/api/json?tree=$RUNS" lint-88.json
  ADDR=https://ci.example.org
  route_builds "$ADDR" root.json
  call runs cdc3609
  check status "$STATUS" 0
  check count "$(records length)" 4
  check_json lint '.[3] | [.id, .source, .links, .data.config,
      .data.result]' << EOF
["https://ci.example.org/job/tools/job/lint/88/", "https://ci.example.org",
 [["commit", "$SHA"]], {}, "pass"]
EOF
}

# Credentials go only to URLs under ADDR
test_runs_not_under() {
  login
  ADDR=https://ci.example.org
  route_builds "$ADDR" elsewhere.json
  call runs cdc3609
  check status "$STATUS" 1
  check_has error "$ERR" \
    'Not under https://ci.example.org: https://other.example.org/'
  check requests "$(requests length)" 1
}

test_runs_fail() {
  route_builds "$ADDR" not-found.html 500
  call runs cdc3609
  check status "$STATUS" 1
  check_has error "$ERR" "Cannot read $ADDR/api/json: HTTP 500"
}

# The token goes to curl in its config on stdin
test_runs_logged_in() {
  login
  route_matrix
  call runs cdc3609
  check status "$STATUS" 0
  check auth "$(requests '[.[].auth] | unique | .[]')" stdin
  check user "$(requests '[.[].user] | unique | .[]')" "CORP\\jdoe:$SECRET"
}

test_run() {
  route GET "${EL9}api/json?tree=$BUILD" run-el9.json
  call run "$EL9"
  check status "$STATUS" 0
  check_json run '.[0] | [.id, .basis, .links, .data.result,
      .data.config.distro]' << EOF
["$EL9", "UNSTABLE",
 [["commit", "$SHA"], ["change", "69978"], ["revision", "2"]],
 "fail", "el9.7"]
EOF
}

# A build without Gerrit names the commit it built
test_run_aborted() {
  ADDR=https://ci.example.org
  local run=$ADDR/job/project-master/4567
  route GET "$run/api/json?tree=$BUILD" run-master.json
  call run "$run"
  check status "$STATUS" 0
  check_json run '.[0] | [.links, .data]' << EOF
[[["commit", "9a1b2c3d4e5f60718293a4b5c6d7e8f901234567"]],
 {"commit": "9a1b2c3d4e5f60718293a4b5c6d7e8f901234567", "status": "done",
  "result": "error", "started": "2026-10-14T17:46:40Z",
  "finished": "2026-10-14T17:47:41Z", "url": "$run/", "config": {}}]
EOF
}

test_run_missing() {
  route GET "$ADDR/1/api/json?tree=$BUILD" not-found.html 404
  call run "$ADDR/1/"
  check status "$STATUS" 1
  check output "$OUT" ''
}

test_run_not_under() {
  login
  call run https://other.example.org/job/project-reviews/1/
  check status "$STATUS" 1
  check requests "$(requests length)" 0
}

SUITES='suites[name,duration,cases[status]]'
CASES='className,name,status,duration,errorDetails,errorStackTrace'

test_suites() {
  route GET "${EL9}testReport/api/json?tree=$SUITES" report.json
  route GET "${EL9}api/json?tree=$REVISION" revision.json
  call suites "$EL9"
  check status "$STATUS" 0
  check_json sanity '.[0]' << EOF
{"id": "$EL9#0", "source": "$ADDR", "role": "ci", "kind": "suite",
 "basis": "{\"fail\":2,\"pass\":2,\"skip\":1}",
 "links": [["commit", "$SHA"]],
 "data": {"run": "$EL9", "name": "sanity", "result": "fail",
          "counts": {"pass": 2, "fail": 2, "skip": 1}, "duration": 412.5,
          "url": "${EL9}testReport/"},
 "notes": {}}
EOF
  check_json others '.[1:] | map([.id, .data.name, .data.result,
      .data.counts])' << EOF
[["$EL9#1", "conf-sanity", "pass", {"pass": 2}],
 ["$EL9#2", "sanity-hsm", "skip", {"skip": 1}],
 ["$EL9#3", "empty", "pass", {}]]
EOF
}

# A build without a test report has no suites
test_suites_no_report() {
  route GET "${EL9}testReport/api/json?tree=$SUITES" not-found.html 404
  call suites "$EL9"
  check status "$STATUS" 0
  check output "$OUT" ''
  check requests "$(requests length)" 1
}

test_suites_fail() {
  route GET "${EL9}testReport/api/json?tree=$SUITES" not-found.html 503
  call suites "$EL9"
  check status "$STATUS" 1
  check output "$OUT" ''
}

# Only the suite's own cases are asked for
test_tests() {
  route GET "${EL9}testReport/api/json?tree=suites[cases[$CASES]]{0,1}" \
    report-suite0.json
  route GET "${EL9}api/json?tree=$REVISION" revision.json
  call tests "$EL9#0"
  check status "$STATUS" 0
  check_json failed '.[2]' << EOF
{"id": "$EL9#0#2", "source": "$ADDR", "role": "ci", "kind": "test",
 "basis": "FAILED", "links": [["commit", "$SHA"]],
 "data": {"suite": "$EL9#0", "name": "sanity.test_51b", "result": "fail",
          "error": "dd failed: No space left on device", "duration": 41.5,
          "url": null},
 "notes": {}}
EOF
  check_json all 'map([.data.name, .data.result, .data.error])' << 'EOF'
[["sanity.test_0a", "pass", null], ["sanity.test_1", "pass", null],
 ["sanity.test_51b", "fail", "dd failed: No space left on device"],
 ["sanity.test_60a", "skip", null],
 ["test_101", "fail", "java.lang.AssertionError: timed out"]]
EOF
}

test_tests_no_such_suite() {
  route GET "${EL9}testReport/api/json?tree=suites[cases[$CASES]]{7,8}" \
    report-none.json
  call tests "$EL9#7"
  check status "$STATUS" 1
  check_has error "$ERR" "No such suite: $EL9#7"
}

test_tests_not_a_suite() {
  call tests "$EL9"
  check run "$STATUS" 1
  call tests "${EL9}#x"
  check index "$STATUS" 1
  check requests "$(requests length)" 0
}

# A log is a download URL: the console, then each artifact
test_logs() {
  route GET "${EL9}api/json?tree=url,result,artifacts[relativePath]" \
    artifacts.json
  call logs "$EL9"
  check status "$STATUS" 0
  check_json console '.[0]' << EOF
{"id": "${EL9}consoleText", "source": "$ADDR", "role": "ci", "kind": "log",
 "basis": "FAILURE", "links": [],
 "data": {"of": "$EL9", "name": "console.log",
          "url": "${EL9}consoleText", "size": null},
 "notes": {}}
EOF
  check_json artifacts '.[1:] | map([.data.name, .data.url])' << EOF
[["artifacts/repodata/bac1c300-primary.xml.gz",
  "${EL9}artifact/artifacts/repodata/bac1c300-primary.xml.gz"],
 ["artifacts/RPMS/x86_64/project 2.16#1+rc.rpm",
  "${EL9}artifact/artifacts/RPMS/x86_64/project%202.16%231%2Brc.rpm"]]
EOF
}

test_logs_running() {
  local run=https://ci.example.org/job/project-master/4568
  ADDR=https://ci.example.org
  route GET "$run/api/json?tree=url,result,artifacts[relativePath]" \
    artifacts-running.json
  call logs "$run"
  check status "$STATUS" 0
  check_json logs 'map([.basis, .data.name])' << 'EOF'
[["running", "console.log"]]
EOF
}

# Jenkins keeps logs per build only
test_logs_suite() {
  call logs "$EL9#0"
  check status "$STATUS" 2
  check requests "$(requests length)" 0
}

RETEST='_class,url,actions[parameters[name,value]]'

# A configuration is built again by building its matrix job with the
# build's parameters, the reason as the cause
test_retest_matrix() {
  login
  echo '{"reason": "PRJ-930: flaky test"}' > "$IN"
  route GET "${EL9}api/json?tree=$RETEST" retest-run.json
  route POST "$ADDR/buildWithParameters" - 201
  call retest "$EL9"
  check status "$STATUS" 0
  check output "$OUT" ''
  check post "$(requests '.[1] | "\(.method) \(.url)"')" \
    "POST $ADDR/buildWithParameters"
  check body "$(requests '.[1].body | split("&") | .[]')" \
    'GERRIT_CHANGE_NUMBER=69978
GERRIT_REFSPEC=refs%2Fchanges%2F78%2F69978%2F2
GERRIT_CHANGE_SUBJECT=PRJ-930%20doc%3A%20fix%20a%20%26%20b
cause=PRJ-930%3A%20flaky%20test'
  check auth "$(requests '.[1].auth')" stdin
  check "body on the command line" \
    "$(requests '.[1].args | map(select(contains("cause"))) | length')" 0
}

test_retest_freestyle() {
  local run=https://ci.example.org/job/project-master/4567/
  ADDR=https://ci.example.org
  echo '{"reason": 12}' > "$IN"
  route GET "${run}api/json?tree=$RETEST" retest-master.json
  route POST "$ADDR/job/project-master/buildWithParameters" - 201
  call retest "$run"
  check status "$STATUS" 0
  check body "$(requests '.[1].body')" cause=12
}

test_retest_no_reason() {
  echo '{}' > "$IN"
  call retest "$EL9"
  check empty "$STATUS" 1
  echo 'PRJ-930' > "$IN"
  call retest "$EL9"
  check "not JSON" "$STATUS" 1
  check requests "$(requests length)" 0
}

test_retest_refused() {
  echo '{"reason": "flaky"}' > "$IN"
  route GET "${EL9}api/json?tree=$RETEST" retest-run.json
  route POST "$ADDR/buildWithParameters" not-found.html 403
  call retest "$EL9"
  check status "$STATUS" 1
  check_has error "$ERR" "Cannot retest $EL9"
}

run() {
  local failed=$FAILED
  TEST=$1
  TEST_DIR=$DIR/$1
  IN=$TEST_DIR/in
  mkdir -p "$TEST_DIR/home"
  : > "$IN"
  (
    export HOME=$TEST_DIR/home
    export FAKE=$TEST_DIR
    "$1"
    audit
    exit $((FAILED - failed))
  ) || FAILED=$((FAILED + $?))
  if [ $FAILED -eq $failed ]; then
    echo "ok $1"
  else
    echo "not ok $1"
  fi
}

if [ "$1" == "-h" -o "$1" == "--help" ]; then
  usage
  exit 0
fi
command -v jq > /dev/null || die "jq is not installed"
trap cleanup EXIT
export PATH=$CURDIR/bin:$PATH
[ "$(command -v curl)" == "$CURDIR/bin/curl" ] || die "curl is not the fake"
export FIXTURES=$CURDIR/fixtures
unset JENKINS_USER JENKINS_TOKEN

TESTS=("$@")
[ $# -gt 0 ] || TESTS=($(declare -F | cut -d' ' -f3 | grep '^test_'))
for test in "${TESTS[@]}"; do
  declare -F "$test" > /dev/null || die "No such test: $test"
  run "$test"
done
[ $FAILED -eq 0 ] || die "$FAILED failed"
